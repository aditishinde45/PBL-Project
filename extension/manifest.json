{
  "manifest_version": 3,
  "name": "ElderEase — Safe Browser Helper",
  "version": "1.0.0",
  "description": "A patient, accessible AI companion for seniors to navigate websites safely one step at a time.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ElderEase Browser Helper"
  },
  "background": {
    "service_worker": "background.js"
  }
}
