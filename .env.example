# ==========================================
# ElderEase Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If local MongoDB is running: mongodb://127.0.0.1:27017/elderease
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/elderease
MONGODB_URI=mongodb://127.0.0.1:27017/elderease

# JWT Secret for Session Authentication
JWT_SECRET=elderease_super_secure_jwt_secret_key_change_in_production_2026

# AI Provider Configuration (OpenAI Compatible)
# Set to any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Ollama, DeepSeek, Google Gemini OpenAI endpoint)
AI_PROVIDER=custom
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# AI Vision Model Configuration
# Model with multimodal vision capabilities for screenshot help
AI_VISION_MODEL=gpt-4o-mini

# Note: If AI_API_KEY is left empty, ElderEase automatically operates
# in its comprehensive high-intelligence Built-in Senior Teacher & Vision Demo Mode.
# All lessons, voice tutoring, and screenshot guidance work seamlessly out-of-the-box!
